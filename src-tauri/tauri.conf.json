{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LunaCode",
  "version": "0.3.0",
  "identifier": "dev.lunacode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LunaCode",
        "width": 1440,
        "height": 900,
        "center": true,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyN0IzQjhDMDVCRkVFOTkKUldTWjdyOEZqRHQ3TWs4cDR0ZVpHaWk3QzA1RXJzTjFHZlhaSzFUQklNZUR3MVBOZ2dnUzYydmEK",
      "endpoints": [
        "https://github.com/GuilhermeFelix95/lunaCode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
