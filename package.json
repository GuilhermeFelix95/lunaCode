{
  "name": "lunacode",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "luna": "bin/luna.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "scripts\\with-msvc.cmd npx tauri build --no-bundle",
    "release:app": "scripts\\with-msvc.cmd npx tauri build --bundles nsis --config src-tauri/tauri.release.conf.json",
    "dev:app": "scripts\\with-msvc.cmd npx tauri dev",
    "luna": "node bin/luna.mjs dev",
    "test": "vitest run",
    "tauri": "tauri",
    "test:rust": "scripts\\with-msvc.cmd cargo test --manifest-path src-tauri\\Cargo.toml",
    "test:smoke": "scripts\\with-msvc.cmd cargo test --manifest-path src-tauri\\Cargo.toml --test cli_smoke -- --ignored --nocapture"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-notification": "2.5.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.50.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
